# Node
node_modules/

# Rust / Tauri
src-tauri/target/
*.rs.bk

# Frontend build
dist/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Other
.filenignore
InkyCap.code-workspace

# Runtime scheduled-task lock (per-machine; created/removed by the app)
.claude/scheduled_tasks.lock

# Design assets: source artwork + the icon-tile the build derives from the
# mark (src/assets/inkycap-logo.svg) via scripts/gen-icon-tile.mjs. Versioned
# so the icon build's inputs travel with the repo.

# Sidecar binaries (downloaded per-platform, ~30MB each)
src-tauri/binaries/

# Dockerised Linux build (scripts/build-linux-docker.sh): the container's
# separate Cargo target dir and the collected deb/AppImage/rpm artifacts.
target-docker/
dist-linux/

# Flatpak build (scripts/build-flatpak.sh): builder cache, local repo, build
# tree, and the .deb staged for the manifest. The .flatpak output lands in
# dist-linux/ (already ignored above).
.flatpak-builder/
flatpak/.build/

# Release manifest staging (scripts/publish-manifest.sh): the signed artifacts'
# .sig files copied off the build machines, plus the generated latest.json.
release-artifacts/
/latest.json
flatpak/.repo/
flatpak/inkycap.deb
