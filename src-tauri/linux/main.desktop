# Desktop entry for the deb, rpm and Flatpak packages, generated by Tauri
# from src-tauri/linux/main.desktop.
#
# This is Tauri's own default template with translated Comment lines added,
# because the bundler writes only the untranslated one. The English text is
# bundle.shortDescription in tauri.conf.json; the translations are kept here,
# since nothing else in the build knows about them. Another language is one
# more Comment[<code>] line: desktop environments fall back from a regional
# code to the plain language, so Comment[fr] covers fr_CA and fr_FR alike.
#
# When upgrading Tauri, compare the fields below with its own template at
# crates/tauri-bundler/src/bundle/linux/freedesktop/main.desktop. A field
# added there and missed here is a field missing from the installed entry.
[Desktop Entry]
Categories={{categories}}
{{#if comment}}
Comment={{comment}}
Comment[fr]=PKM basé sur Typst, avec notes liées, pour l'écriture et la recherche académiques
{{/if}}
Exec={{exec}}
StartupWMClass={{exec}}
Icon={{icon}}
Name={{name}}
Terminal=false
Type=Application
{{#if mime_type}}
MimeType={{mime_type}}
{{/if}}
