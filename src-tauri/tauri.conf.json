{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InkyCap",
  "version": "26.9.12",
  "identifier": "com.inkycap.editor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "InkyCap",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https: data: blob:; media-src 'self' asset: https: data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost asset: https:; worker-src 'self' blob:",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [],
          "deny": []
        }
      }
    }
  },
  "plugins": {
    "shell": {
      "open": "(mailto:\\w+|tel:\\w+|https?://\\w+|[a-zA-Z][a-zA-Z0-9+.-]+://).+"
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg3QzNBN0ZDM0NEOTM4RUQKUldUdE9OazgvS2ZEaHhSV2JqcExvUTVyUTJzSjRqL3dEc2FWMlR5SWJNakJRZkREQXlrQVF2Y3UK"
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "shortDescription": "Typst-based PKM with linked-notes for writing and academic research",
    "longDescription": "InkyCap focuses on academics, writers, and anyone wanting both conventional PKM functionality and advanced features for publishing, knowledge discovery, recall, and ideation, as well as agenda-keeping, project creation, and more.",
    "targets": [
      "deb",
      "rpm",
      "nsis",
      "msi",
      "app",
      "dmg"
    ],
    "publisher": "Joshua Chalifour",
    "copyright": "© 2026 Joshua Chalifour",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png"
    ],
    "externalBin": [
      "binaries/inkycap-tinymist"
    ],
    "resources": [
      "licenses/*"
    ],
    "linux": {
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav"
        ],
        "files": {
          "/usr/share/icons/hicolor/scalable/apps/inkycap.svg": "icons/icon.svg"
        },
        "postInstallScript": "deb/postinst",
        "postRemoveScript": "deb/postrm",
        "desktopTemplate": "linux/main.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/main.desktop"
      }
    }
  }
}
