{
  "name": "inkycap",
  "version": "0.1.0",
  "description": "A Tauri-based Typst editor for academic and research note-taking",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "tauri": "tauri",
    "icons": "npx tauri icon design-assets/inkycap-logo.svg",
    "tauri:dev": "env -u GTK_PATH -u GDK_PIXBUF_MODULEDIR -u GDK_PIXBUF_MODULE_FILE -u SNAP_LIBRARY_PATH -u GSETTINGS_SCHEMA_DIR -u LOCPATH -u GIO_MODULE_DIR -u GIO_LAUNCHED_DESKTOP_FILE XDG_DATA_DIRS=\"$XDG_DATA_DIRS_VSCODE_SNAP_ORIG\" npm run tauri dev"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@types/katex": "^0.16.8",
    "solid-js": "^1.9.12",
    "typescript": "^6.0.2",
    "vite": "^8.0.7",
    "vite-plugin-solid": "^2.11.12",
    "vite-plugin-wasm": "^3.6.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.5",
    "@codemirror/merge": "^6.12.1",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.1",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "codemirror-lang-typst": "^0.4.0",
    "katex": "^0.16.45",
    "lucide-solid": "^1.8.0"
  }
}
